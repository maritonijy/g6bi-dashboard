@{
    ViewData["Title"] = "Presentation";
    Layout = "_PresentationLayout";
    var decks = PresentationCatalog.Decks;
    var elements = ElementCatalog.All.ToDictionary(e => e.Id);
    var tables = PresentationCatalog.Tables;
    var firstTable = PresentationCatalog.Tables[0];
}

<div class="pp" id="pp">
    <aside class="pp-side" id="ppSide">
        <div class="pp-brand">
            <span class="pp-mark">K</span>
            <span class="pp-brand-text">
                <b>Kova Inc. · FY2025</b>
                <small>Finance Performance Analysis</small>
            </span>
        </div>
        <nav class="pp-nav" id="ppNav" aria-label="Presentation sections"></nav>
        <div class="pp-side-foot">
            <span class="pp-key">←</span><span class="pp-key">→</span> move
            <span class="pp-sep">·</span>
            <span class="pp-key">Esc</span> exit
        </div>
    </aside>

    <div class="pp-main">
        <header class="pp-top">
            <div class="pp-top-left">
                <span class="pp-dot" aria-hidden="true"></span>
                <span class="pp-top-title">Finance Performance Analysis Dashboard</span>
                <span class="pp-top-sub">ITELEC4 · Final Project · Group 6</span>
            </div>
            <div class="pp-top-right">
                <a class="pp-ghost" href="/Home/Schema">Model &amp; tables</a>
                <button id="ppFsTop" class="pp-solid" type="button">Present</button>
            </div>
        </header>

        <div class="pp-stage" id="ppStage">
            <div class="pp-frame" id="ppFrame">

                <!-- 1 · Title -->
                <section class="pp-slide" data-title="Title" data-group="Opening">
                    <div class="pp-canvas pp-legacy pp-title-slide">
                        <div class="eyebrow">ITELEC4 · Final Project · Group 6</div>
                        <h1 class="pp-title">Finance Performance<br />Analysis Dashboard</h1>
                        <p class="sub pp-lead">Kova Inc. · FY2025 · Revenue, budget, cash, receivables and payables</p>
                        <div class="pills">
                            <span class="pill on">3 dashboards</span>
                            <span class="pill">Star Schema</span>
                            <span class="pill">Slicers and tooltips</span>
                            <span class="pill">KOVA Dataset</span>
                            <span class="pill">Takeaways</span>
                        </div>
                        <div class="sub pp-credits">
                            <b>Prepared by</b>
                            <ul class="pp-title-credits">
                                <li>JOAN N. CHAVEZ · Researcher</li>
                                <li>ANGELA M. DELIMA · Documentation Lead</li>
                                <li>JAYRALD MIGUEL O. DORONIO · KPI Analyst</li>
                                <li>FREDELINA R. GONZALES · Data Analyst</li>
                                <li>JERICHO E. MAGSINO · Visualization Designer</li>
                                <li>MARITONI JOY SAPINOSO · Dashboard Developer</li>
                            </ul>
                            <p class="pp-title-instructor">Instructor: PROF. ARSENIO ARELLANO JR.</p>
                        </div>
                    </div>
                </section>

                <!-- 2 · Business problem (existing page, preserved) -->
                <section class="pp-slide" data-title="Business problem" data-group="Opening">
                    <div class="pp-canvas pp-legacy">
                        <div class="eyebrow">The business problem</div>
                        <h2>Revenue grows, but the company still loses money</h2>
                        <p class="sub pp-lead">Each dashboard answers one management question about a specific area of financial performance.</p>
                        <ul class="bullets pp-legacy-bullets">
                            <li><b>Revenue grew 42.1%</b> in FY2025, from $878K in January to $1.25M in December.</li>
                            <li><b>Expenses grew 37.7%</b> and were higher than revenue in every month. The result is a net loss of $2.03M.</li>
                            <li><b>Users</b> are the CFO, finance partners, department heads and treasury. They need to know where profit is lost, which budgets are over, and whether cash covers obligations.</li>
                        </ul>
                    </div>
                </section>

                <!-- 3 · Three dashboards (existing page, preserved; cards now navigate inside the deck) -->
                <section class="pp-slide" data-title="Dashboard structure" data-group="Opening">
                    <div class="pp-canvas pp-legacy">
                        <div class="eyebrow">What we are presenting</div>
                        <h2>Three dashboards, three questions</h2>
                        <div class="grid-cards pp-legacy-cards">
                            <button type="button" class="link-card" data-goto="5">
                                <div class="eyebrow">Dashboard 1</div>
                                <h3>Executive Financial Health</h3>
                                <p class="sub">“Are we making money, and is the trend getting better or worse?”</p>
                                <p class="hint">Open the dashboard →</p>
                            </button>
                            <button type="button" class="link-card" style="border-top-color:var(--violet)" data-goto="10">
                                <div class="eyebrow" style="color:var(--violet)">Dashboard 2</div>
                                <h3>Profitability &amp; Budget Control</h3>
                                <p class="sub">“Where is the money going, and are we staying inside the budget?”</p>
                                <p class="hint">Open the dashboard →</p>
                            </button>
                            <button type="button" class="link-card" style="border-top-color:var(--mint)" data-goto="16">
                                <div class="eyebrow" style="color:var(--mint)">Dashboard 3</div>
                                <h3>Cash, Receivables &amp; Payables</h3>
                                <p class="sub">“Can we pay our bills, and is the cash actually collected?”</p>
                                <p class="hint">Open the dashboard →</p>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- 4 · Data tables -->
                <section class="pp-slide" data-title="Data tables" data-group="Opening">
                    <div class="pp-canvas pp-tables">
                        <header class="pp-tables-head">
                            <div>
                                <div class="pp-eyebrow">Data model · Page 4</div>
                                <h1>Tables used in the Power BI project</h1>
                                <p class="pp-sub">Thirteen model tables, including 29 named DAX measures. Select a table to inspect its fields, data types and visibility.</p>
                            </div>
                            <div class="pp-chiprow">
                                <button type="button" id="ppRelationshipOpen" class="pp-chip pp-relationship-btn" aria-haspopup="dialog" aria-controls="ppRelationshipModal">Relationship</button>
                                <span class="pp-chip on">4 fact</span>
                                <span class="pp-chip">3 dimension</span>
                                <span class="pp-chip">2 supporting</span>
                                <span class="pp-chip">4 auto date</span>
                            </div>
                        </header>

                        <div class="pp-tables-body">
                            <div class="pp-tlist">
                                @foreach (var kind in PresentationCatalog.Kinds)
                                {
                                    var group = tables.Where(t => t.Kind == kind).ToArray();
                                    <div class="pp-tgroup">@kind <span>@group.Length</span></div>
                                    foreach (var table in group)
                                    {
                                        <button type="button" class="pp-trow @(table == firstTable ? "on" : "")" data-table="@table.Name" title="@table.Name">
                                            <span class="pp-trow-name">@table.Name</span>
                                            <span class="pp-trow-cols">@table.Columns.Count(c => !c.Hidden)</span>
                                        </button>
                                    }
                                }
                            </div>

                            <div class="pp-tdetails">
                                @foreach (var table in tables)
                                {
                                    <article class="pp-tdetail @(table == firstTable ? "on" : "")" data-table="@table.Name">
                                        <div class="pp-tdetail-head">
                                            <div>
                                                <div class="pp-eyebrow">@table.Kind table</div>
                                                <h2>@table.Name</h2>
                                            </div>
                                            <span class="pp-badge">
                                                @table.Columns.Count(c => !c.Hidden) visible ·
                                                @table.Columns.Count(c => c.Hidden) hidden
                                            </span>
                                        </div>
                                        <p class="pp-tdetail-purpose">@table.Purpose</p>
                                        <div class="pp-cols-wrap">
                                            <table class="pp-cols">
                                                <thead>
                                                    <tr><th>@(table.Name == "_Measures" ? "Measure" : "Column")</th><th>Data type</th><th>Visibility</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var column in table.Columns)
                                                    {
                                                        <tr class="@(column.Hidden ? "is-hidden" : "")">
                                                            <td>@column.Name</td>
                                                            <td>@column.DataType</td>
                                                            <td>@(column.Hidden ? "Hidden" : "Visible")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>

                        <p class="pp-tables-foot">
                            Model view relationships: budget update 2026 and ledger update 2026 link to dim_account, dim_department and dim_month; invoices update 2026 links to dim_month. Cash update 2026, WC Steps and _Measures show no relationships. Confirm cardinality and filter direction in Power BI’s Model view.
                        </p>
                    </div>
                </section>

                @foreach (var deck in decks)
                {
                    var overviewSlide = deck.Number == 1 ? 5 : deck.Number == 2 ? 10 : 16;

                    <!-- Dashboard overview: interactive report embedded from the project's own dashboard page -->
                    <section class="pp-slide pp-ov" data-title="Dashboard @deck.Number · Overview" data-group="@deck.Group">
                        <div class="pp-canvas">
                            <header class="pp-ov-head">
                                <div class="pp-ov-title">
                                    <div class="pp-eyebrow">Dashboard @deck.Number · Interactive report · Page @deck.Number of 3</div>
                                    <h1>@deck.Name</h1>
                                    <p class="pp-sub">@(deck.Number == 1
                                        ? "Are we making money, and is the trend improving or declining?"
                                        : deck.Number == 2
                                            ? "Where is the money going, and are we staying inside the budget?"
                                            : "Can we pay our bills, and is the cash actually collected?")</p>
                                </div>
                                <div class="pp-ov-tools">
                                    @if (deck.Number == 1)
                                    {
                                        <span class="pp-chip on">Quarter slicer</span>
                                        <span class="pp-chip">Click a month</span>
                                        <span class="pp-chip">6 KPIs</span>
                                        <span class="pp-chip">3 visuals</span>
                                    }
                                    else if (deck.Number == 2)
                                    {
                                        <span class="pp-chip on">Department slicer</span>
                                        <span class="pp-chip">Click a bar</span>
                                        <span class="pp-chip">5 KPIs</span>
                                        <span class="pp-chip">4 visuals</span>
                                    }
                                    else
                                    {
                                        <span class="pp-chip on">Bank slicer</span>
                                        <span class="pp-chip">Click a bank</span>
                                        <span class="pp-chip">6 KPIs</span>
                                        <span class="pp-chip">5 visuals</span>
                                    }
                                </div>
                            </header>

                            <div class="pp-report">
                                <div class="pp-report-fit">
                                    <iframe data-src="/dashboard/@deck.Number?embed=1"
                                            title="Dashboard @deck.Number: @deck.Name, interactive"></iframe>
                                </div>
                            </div>
                        </div>
                    </section>

                    var position = 0;
                    foreach (var id in deck.ElementIds)
                    {
                        position++;
                        var item = elements[id];
                        var label = $"Dashboard {deck.Number} · Element {position} of {deck.ElementIds.Length}";
                        <partial name="_ElementSlide" model="new ElementSlideModel(item, PresentationCatalog.Visuals[id], label, deck.Group)" />
                    }
                }

                <!-- 23 · Next steps (PDF order) -->
                <section class="pp-slide" data-title="Next steps · Recommendations" data-nav="Recommendations" data-group="Closing">
                    <div class="pp-canvas pp-legacy pp-recos">
                        <div class="eyebrow">Next steps</div>
                        <h2>Recommendations</h2>
                        <p class="sub pp-lead">Six actions that follow from the three dashboards.</p>
                        <ol class="pp-reco-list">
                            <li><span>1</span>Set monthly revenue targets based on operating costs.</li>
                            <li><span>2</span>Review and control major operating expenses.</li>
                            <li><span>3</span>Monitor departmental budget variances.</li>
                            <li><span>4</span>Improve customer payment collection.</li>
                            <li><span>5</span>Review supplier payment terms.</li>
                            <li><span>6</span>Monitor foreign currency cash balances.</li>
                        </ol>
                    </div>
                </section>

                <!-- 24 · Closing (PDF order) -->
                <section class="pp-slide" data-title="Conclusion" data-group="Closing">
                    <div class="pp-canvas pp-legacy pp-closing">
                        <div class="eyebrow">Closing</div>
                        <h2>Conclusion</h2>
                        <p class="pp-closing-text">The dashboard provides a consolidated view of Kova Inc.'s FY2025 financial performance. It helps identify profitability issues, spending patterns, and cash management concerns. Its interactive visuals support faster financial analysis and more informed decisions.</p>
                        <p class="pp-credits">Group 6 · Finance Performance Analysis Dashboard · Kova Inc. FY2025</p>
                    </div>
                </section>

                <!-- 25 · Thank-you page -->
                <section class="pp-slide" data-title="Thank you" data-group="Closing">
                    <div class="pp-canvas pp-legacy pp-thankyou">
                        <div class="eyebrow">That’s a wrap</div>
                        <div class="pp-thankyou-layout">
                            <div class="pp-thankyou-copy">
                                <h1>Thank you!</h1>
                                <p>Thanks for listening. Sending you a purr-sonal flying kiss!</p>
                            </div>
                            <div class="pp-thankyou-cat">
                                <span class="pp-cat-speech">Mwah! Thanks a meow-llion!</span>
                                <svg viewBox="0 0 440 360" role="img" aria-labelledby="thankyou-cat-title thankyou-cat-desc" xmlns="http://www.w3.org/2000/svg">
                                    <title id="thankyou-cat-title">A cat sending a flying kiss</title>
                                    <desc id="thankyou-cat-desc">A goofy floating cat blows a kiss with little hearts trailing away.</desc>
                                    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M45 245c26-20 43-21 62-13M34 274c24-14 39-14 56-8M59 302c17-8 31-9 45-5" stroke="#4DA6FF" stroke-width="6" opacity=".8" />
                                        <path class="pp-cat-heart pp-cat-heart-one" d="M328 117c19-18 37-17 48 1 15-13 35-5 34 13-1 22-42 44-42 44s-43-31-40-52Z" fill="#FF6B7A" stroke="#FF9BA5" stroke-width="4" />
                                        <path class="pp-cat-heart pp-cat-heart-two" d="M367 195c11-10 22-9 28 1 9-7 20-3 19 8-1 13-24 26-24 26s-25-18-23-31Z" fill="#A68CF4" stroke="#C2B3FF" stroke-width="3" />
                                        <path class="pp-cat-heart pp-cat-heart-three" d="M301 82c9-8 18-7 23 1 7-6 16-2 15 7 0 10-19 20-19 20s-20-14-19-24Z" fill="#EBD372" stroke="#F5E6A7" stroke-width="3" />
                                        <path d="M110 228c-28 8-50 2-62-16-9-14-5-31 9-34 11-2 17 7 16 16-3 15 9 18 25 11" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="M134 249c-5 30 5 48 27 50 17 1 24-10 18-20-7-11-19-8-22 0M258 259c1 28 13 42 33 38 15-3 18-16 9-23-9-7-20-2-20 7" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="M141 195c-4 47 23 78 71 79 38 0 67-19 78-53l-29-53-92-4Z" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="M268 214c16-34 28-69 40-83 8-10 22-7 22 4 0 10-11 21-16 34 16-10 27-9 31 0 4 10-10 17-24 25-9 5-13 17-22 31" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="M129 145 123 78l66 36M226 112l57-50 8 79" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="m139 128-5-34 35 21m70-4 28-25 4 36" fill="#FFB1BC" stroke="#C4A7FF" stroke-width="4" />
                                        <ellipse cx="205" cy="153" rx="83" ry="72" fill="#252C40" stroke="#C4A7FF" stroke-width="7" />
                                        <path d="M158 145c7-10 18-10 25 0m42-1c7-10 18-10 25 0" stroke="#F2F2F2" stroke-width="6" />
                                        <ellipse cx="151" cy="171" rx="12" ry="7" fill="#FF9BA5" stroke="none" />
                                        <ellipse cx="262" cy="171" rx="12" ry="7" fill="#FF9BA5" stroke="none" />
                                        <path d="m196 169 9 7 9-7c0-8-9-8-9-2 0-6-9-6-9 2Zm9 7v8m0 0c-6 8-14 7-18 1m18-1c6 8 14 7 18 1" fill="#FF6B7A" stroke="#F2F2F2" stroke-width="3" />
                                        <path d="M135 170 97 162m40 21-42 8m174-22 28-9m-31 24 35 8" stroke="#F2F2F2" stroke-width="3" />
                                        <path d="M309 145c13-10 22-18 27-29" stroke="#FF6B7A" stroke-width="4" stroke-dasharray="4 9" />
                                        <path d="M87 111l5 11 12 2-9 8 2 12-10-6-11 6 3-12-9-8 12-2Zm248 151 4 9 10 2-8 6 2 10-8-5-9 5 3-10-8-6 10-2Z" fill="#EBD372" stroke="none" />
                                    </g>
                                </svg>
                            </div>
                        </div>
                        <p class="pp-credits">Group 6 · Kova Inc. · FY2025</p>
                    </div>
                </section>

            </div>
        </div>

        <footer class="pp-bottom">
            <div class="pp-ctrls">
                <button id="ppPrev" type="button" class="pp-btn" aria-label="Previous slide" title="Previous (←)">‹</button>
                <span id="ppCounter" class="pp-counter" aria-live="polite">1 of 25</span>
                <button id="ppNext" type="button" class="pp-btn" aria-label="Next slide" title="Next (→)">›</button>
            </div>

            <div class="pp-thumbs-wrap">
                <div id="ppThumbs" class="pp-thumbs" aria-label="Slide thumbnails"></div>
            </div>

            <div class="pp-bottom-right">
                <span class="pp-hintline"><span class="pp-key">←</span><span class="pp-key">→</span> navigate</span>
                <button id="ppFs" type="button" class="pp-btn pp-fs" aria-label="Toggle full screen" title="Full screen (F)">Full screen</button>
            </div>
        </footer>
    </div>

    <div class="pp-rel-modal" id="ppRelationshipModal" role="dialog" aria-modal="true" aria-labelledby="ppRelationshipTitle" aria-hidden="true" hidden>
        <div class="pp-rel-backdrop" data-rel-close></div>
        <section class="pp-rel-window" tabindex="-1">
            <h2 id="ppRelationshipTitle">Model relationships</h2>
            <button type="button" class="pp-rel-close" aria-label="Close relationships window" title="Close" data-rel-close>×</button>
            <img src="/presentation/images/04-relationships.png" alt="Power BI model diagram showing relationships between budget, invoice, ledger and dimension tables" />
        </section>
    </div>
</div>
